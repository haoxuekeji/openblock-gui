<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="google" value="notranslate">
  <link rel="shortcut icon" href="static/favicon.ico">
  <title>
    <%= htmlWebpackPlugin.options.title %>
  </title>
  <% if (htmlWebpackPlugin.options.sentryConfig) { %>
    <!-- Sentry error logging to help with finding bugs -->
    <script src="https://cdn.ravenjs.com/3.22.1/raven.min.js" crossorigin="anonymous"></script>
    <script>
      Raven.config(<%= htmlWebpackPlugin.options.sentryConfig %>).install();
    </script>
    <!-- /Sentry -->
    <% } %>
</head>
<script>
  var host = 'http://192.168.60.191:50000'; // 修改为你的后端地址
  function handleProjectId(id) {
    console.log(id)
  }
  window.scratchConfig = {
    logo: {
      show: true
      , handleClickLogo: () => {
        console.log('点击LOGO')
      }
    },
    menuBar: {
      color: 'hsla(215, 100%, 65%, 1)', //菜单栏颜色
      //新建按钮
      newButton: {
        show: true,
        handleBefore() {
          return true
        }
      },
      //从计算机加载按钮
      loadFileButton: {
        show: true,
        handleBefore() {
          return true
        }
      },
      //保存到计算机按钮
      saveFileButton: {
        show: true,
        handleBefore() {
          return true
        }
      },
      //加载库按钮
      libButton: {
        show: true
      },
      //教程按钮
      helpButton: {
        show: true
      }
    },

    shareButton: {
      show: true,
      buttonName: "提交",
      handleClick: () => {
        console.log('分享按钮')
      }
    },
    profileButton: {
      show: false,
      buttonName: "我的作品",
      handleClick: () => {
        //点击profile按钮
        console.log('我的作品')
      }
    },
    guideButton: {
      show: false,
      buttonName: '课程指导书',
      handleClick: () => {
        console.log('课程指导')
      }
    },
    handleVmInitialized: (vm) => {
      window.vm = vm
      console.log("VM初始化完毕")
      //vm.addListener('PROJECT_ID', handleProjectId);
      // setTimeout(() => {
      //   window.scratch.setProjectId(15)
      // }, 0)


    },
    handleProjectLoaded: () => {
      console.log("作品载入完毕")
      window.scratch.setProjectName("我的作品")
    },
    handleDefaultProjectLoaded: () => {
      console.log("默认作品载入完毕")
      //默认作品加载完毕，一般在这里控制项目加载
      // window.scratch.setProjectName("默认项目")
      //  window.scratch.loadProject("/project.sb3", () => {
      //     console.log("项目加载完毕")
      //     window.scratch.setProjectName("默认项目")
      //  })

      const token = window.localStorage.getItem('token');
      if (token) {
        fetch(host + '/api/v1/me', {
          method: 'GET',
          headers: {
            'Authorization': 'Bearer ' + token
          }
        })
          .then(response => {
            if (!response.ok) {
              return response.json().then(err => Promise.reject(err));
            }
            return response.json();
          })
          .then(data => {
            if (data && data.name) {
              const sessionData = {
                session: {
                  user: {
                    userid: data.id,
                    username: data.user,
                    token: token,
                    thumbnailUrl: data.avatar || '',
                  }
                }
              };
              window.scratch.setProjectId(5)
              console.log('已恢复登录状态', sessionData);
              if (window.setSession) window.setSession(sessionData);
              
            }
          })
          .catch(err => {
            console.error('获取用户信息失败', err);
          });
      }
    },
    handleProjectIdChange: id => {
      console.log(id)
    },
    handleUpdateProjectTitle: title => {
      console.log(title)
    },
    onLogIn: (userInfo, callback) => {
      
      if (!userInfo || !userInfo.username || !userInfo.password) {
        callback({ success: false, message: '缺少用户名或密码' });
        return;
      }
      
      fetch( host + '/api/v1/token', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          username: userInfo.username,
          password: userInfo.password

        })
      })
        .then(response => {
          if (!response.ok) {
            return response.json().then(err => Promise.reject(err));
          }
          return response.json();
        })
        .then(data => {
          if (data && data.access_token) {
            window.localStorage.setItem('token', data.access_token);
            const sessionData = {
              session: {
                user: {
                  username: userInfo.username,
                  token: data.access_token
                }
              }
            };
            if (window.setSession) window.setSession(sessionData);
            callback({ success: true, access_token: data.access_token });
          } else {
            callback({ success: false, message: '未返回 access_token' });
          }
        })
        .catch(err => {
          console.error('登录失败', err);
          const msg = (err && err.message) || (err && err.error) || '网络或服务器错误';
          callback({ success: false, message: msg });
        });
       
    },
    onLogOut: () => {
      console.log("已退出登录")
          let data = {
        session: {
            user: {
                username: ''
            }
          }
      }
      window.setSession(data);
    },
    handleUpdateProjectThumbnail: (projectId, blob) => {
          fetch(host + '/api/v1/scratch/project/thumbnail/' + projectId, {
            method: 'POST',
            headers: {
              'Authorization': 'Bearer ' + window.localStorage.getItem('token')
            },
            body: blob
          })
            .then(response => {
              if (!response.ok) {
                return response.json().then(err => Promise.reject(err));
              }
              return response.json();
            })
            .then(data => {
              console.log('项目缩略图上传成功', data);
            })
            .catch(err => {
              console.error('项目缩略图上传失败', err);
            });
    },
    mobilePlayer: false,
    defaultProjectURL: "./static/project.sb3",
    //若使用官方素材库请删除本配置项, 默认为/static下的素材库
    assetCDN: host,
    projectHost: host +'/api/v1/scratch/project',
    backpackHost: host + '/api/v1/scratch/backpack',
    cloudHost: '192.168.60.191:50000' + '/api/v1/scratch/cloud-variables',
    login: true,
    isPlayerOnly: false,
    enableCommunity: true,
    arduino: false,
    handleLogin: true,
    autosave: true
  }

</script>

<body>
  <div id='scratch'></div>
</body>

</html>